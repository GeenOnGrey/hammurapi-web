# Hammurapi web: static SPA + reverse proxy to the api.
# In Kubernetes the ingress usually routes /api, /admin/api and /hooks to the api
# service directly (with sticky sessions); this proxy serves docker compose and
# single-host installs.
upstream hammurapi_api {
    server ${API_UPSTREAM};
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Import archives up to 50 MB (IMPORT_MAX_BYTES) plus multipart overhead.
    client_max_body_size 60m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # One SSE stream per browser: no buffering, long timeouts.
    location = /api/v1/events {
        proxy_pass http://hammurapi_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location ~ ^/(api|admin/api|hooks)/ {
        proxy_pass http://hammurapi_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
